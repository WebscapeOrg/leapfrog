#!/usr/bin/env bash
set -euo pipefail

LEAPFROG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cargo fmt --manifest-path "$LEAPFROG_DIR/touchbar/Cargo.toml" --check
cargo clippy --manifest-path "$LEAPFROG_DIR/touchbar/Cargo.toml" --all-targets -- -D warnings
cargo test --manifest-path "$LEAPFROG_DIR/touchbar/Cargo.toml"

for script in \
  "$LEAPFROG_DIR/install.sh" \
  "$LEAPFROG_DIR/bin/leapfrog" \
  "$LEAPFROG_DIR/camera/build-relay" \
  "$LEAPFROG_DIR/hooks/install" \
  "$LEAPFROG_DIR/hooks/post-commit" \
  "$LEAPFROG_DIR/lock/install" \
  "$LEAPFROG_DIR/system/install"; do
  bash -n "$script"
done

python3 - "$LEAPFROG_DIR/theme-gallery/generate_gallery.py" <<'PY'
from pathlib import Path
import sys

source = Path(sys.argv[1]).read_text()
compile(source, sys.argv[1], "exec")
PY

# The the main machine ship sync patches an inert marketplace-plugin staging tree. These cases exercise
# that public interface, which is the only one the sync uses.
#
# ⚠️ NOTHING HERE MAY ASSUME THE LOCAL PLUGIN IS GUARDED. The guard is applied on the MacBook and not on
# the main machine, and the main machine is where the commit is verified. A version of this check that assumed
# "guarded" failed its first case there, and silently skipped the one case that enforces --forward —
# the defect it exists to catch (the machine agent, hobnob #6670). So one UNGUARDED base is derived from
# whatever the local copy happens to be, and every tree below is built from that base.
lock_plugin="$HOME/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer"
if [ -f "$lock_plugin/Service.qml" ]; then
  lock_base="$(mktemp -d)"
  lock_work="$(mktemp -d)"
  trap 'find "$lock_base" "$lock_work" -depth -delete' EXIT
  cp "$lock_plugin/Service.qml" "$lock_base/Service.qml"
  cp "$lock_plugin/manifest.json" "$lock_base/manifest.json"

  lock_base_ok=yes
  if grep -qF 'property int fingerprintFastFailures' "$lock_base/Service.qml"; then
    # ⚠️ >/dev/null 2>&1, not 2>/dev/null. patch writes "Unreversed patch detected! Skipping patch."
    # and "saving rejects to file Service.qml.rej" to STDOUT, so half a redirection leaks them into
    # this script's own output (the machine agent, hobnob #6670).
      # Any candidate may be the one this machine carries, so try each in turn.
      # ⚠️ EXIT 0 IS NOT PROOF. --forward makes patch SKIP hunks that look already-reversed, so a
      # candidate this plugin does NOT carry reverses "successfully" having changed nothing. The
      # marker going away is the only proof the right one came off, and the copy is taken again
      # each time so a half-applied attempt cannot poison the next.
      lock_base_ok=no
      for base_candidate in "$LEAPFROG_DIR/lock/"fingerprint-circuit-breaker*.patch; do
        cp "$lock_plugin/Service.qml" "$lock_base/Service.qml"
        patch -R --forward --batch --silent --no-backup-if-mismatch -d "$lock_base" -p1 \
          < "$base_candidate" >/dev/null 2>&1 || true
        rm -f "$lock_base"/*.orig "$lock_base"/*.rej
        if ! grep -qF 'property int fingerprintFastFailures' "$lock_base/Service.qml"; then
          lock_base_ok=yes
          break
        fi
      done
  fi
  rm -f "$lock_base"/*.orig "$lock_base"/*.rej
  grep -qF 'property int fingerprintFastFailures' "$lock_base/Service.qml" && lock_base_ok=no

  if [ "$lock_base_ok" != yes ]; then
    printf 'script/check: lock-guard cases SKIPPED — no unguarded base could be derived\n' >&2
  else
    lock_tree() { # lock_tree <name> — a fresh copy of the unguarded base
      rm -rf "${lock_work:?}/$1"
      mkdir -p "$lock_work/$1"
      cp "$lock_base/Service.qml" "$lock_base/manifest.json" "$lock_work/$1/"
      printf '%s\n' "$lock_work/$1"
    }
    lock_guard() { # lock_guard <dir> — apply the v1.7 guard, quietly
      patch --forward --batch --silent --no-backup-if-mismatch -d "$1" -p1 \
        < "$LEAPFROG_DIR/lock/fingerprint-circuit-breaker-v1.8.patch" >/dev/null 2>&1
      rm -f "$1"/*.orig "$1"/*.rej
    }
    lock_run() { # lock_run <dir> — stdout+stderr of the guard, status in lock_status
      lock_status=0
      lock_output="$("$LEAPFROG_DIR/lock/install" --plugin-dir "$1" 2>&1)" || lock_status=$?
    }

    # 0. The checksum manifest must match the patch files. lock/install refuses to run when they
    #    disagree, so this only exists to fail with a clear message here rather than on a ship.
    if ! (cd "$LEAPFROG_DIR/lock" && sha256sum --check --quiet --strict patch-checksums.txt) >/dev/null 2>&1
    then
      printf 'lock/patch-checksums.txt does not match the patch files; update it in this change\n' >&2
      ( cd "$LEAPFROG_DIR/lock" && sha256sum --check --strict patch-checksums.txt ) 2>&1 | grep -v ': OK$' >&2
      exit 1
    fi
    for candidate_name in fingerprint-circuit-breaker.patch fingerprint-circuit-breaker-v1.7.patch \
      fingerprint-circuit-breaker-v1.8.patch; do
      if ! grep -qF "  $candidate_name" "$LEAPFROG_DIR/lock/patch-checksums.txt"; then
        printf 'lock/patch-checksums.txt does not list %s\n' "$candidate_name" >&2
        exit 1
      fi
    done

    # 0c. A missing or unreadable manifest must be reported in the guard's OWN words. The loop that
    #     reads it redirects the file into `while read`, so bash reports it instead — with the full
    #     path and no leapfrog-lock: prefix — straight into the sync's note (the machine agent, #6726).
    mkdir -p "$lock_work/nomanifest/lock"
    cp "$LEAPFROG_DIR/lock/install" "$lock_work/nomanifest/lock/install"
    cp "$LEAPFROG_DIR/lock/"*.patch "$lock_work/nomanifest/lock/"
    # ⚠️ A different name from the tool copy above: lock_tree rm -rf's its own directory first, so
    # reusing "nomanifest" would delete the install this case just put there.
    tree="$(lock_tree nomanifest-tree)"
    nomanifest_status=0
    nomanifest_out="$("$lock_work/nomanifest/lock/install" --plugin-dir "$tree" 2>&1)" \
      || nomanifest_status=$?
    if [ "$nomanifest_status" -eq 0 ]; then
      printf 'lock/install accepted a missing manifest: %s\n' "$nomanifest_out" >&2
      exit 1
    fi
    # The WHOLE output, not its prefix: a guard that printed its line but did not stop would be
    # followed by bash's own error, and a prefix match would let that through (the machine agent's review).
    if [ "$nomanifest_out" != "leapfrog-lock: lock/patch-checksums.txt is missing or unreadable" ]; then
      printf 'lock/install let something other than its own message out for a missing manifest: %s\n' \
        "$nomanifest_out" >&2
      exit 1
    fi

    # 0b. A manifest may name a candidate only ONCE. A whole-line match is satisfied by ANY
    #     matching line, so a duplicate — the right hash plus a truncated file's, which is what
    #     appending sha256sum output produces — let the truncated patch install and deleted the
    #     backup (the machine agent's review, hobnob #6720). Built in a copy, because the --strict
    #     comparison above would reject such a manifest in the repo itself.
    mkdir -p "$lock_work/dup/lock"
    cp "$LEAPFROG_DIR/lock/install" "$lock_work/dup/lock/install"
    cp "$LEAPFROG_DIR/lock/"*.patch "$lock_work/dup/lock/"
    cp "$LEAPFROG_DIR/lock/patch-checksums.txt" "$lock_work/dup/lock/patch-checksums.txt"
    awk '/^@@/ { hunks++ } hunks < 4 { print } hunks >= 4 { exit }' \
      "$LEAPFROG_DIR/lock/fingerprint-circuit-breaker-v1.8.patch" \
      > "$lock_work/dup/lock/fingerprint-circuit-breaker-v1.8.patch"
    ( cd "$lock_work/dup/lock" \
      && sha256sum fingerprint-circuit-breaker-v1.8.patch >> patch-checksums.txt )
    tree="$(lock_tree dupmanifest)"
    printf 'backup\n' > "$tree/Service.qml.orig"
    dup_status=0
    dup_out="$("$lock_work/dup/lock/install" --plugin-dir "$tree" 2>&1)" || dup_status=$?
    if [ "$dup_status" -eq 0 ] || [ ! -e "$tree/Service.qml.orig" ] \
      || grep -qF 'property int fingerprintFastFailures' "$tree/Service.qml"; then
      printf 'lock/install accepted a manifest naming a candidate twice: %s\n' "$dup_out" >&2
      exit 1
    fi

    # 1. A guarded tree reports exactly one line. Not a substring: the ship sync's note is this
    #    whole stream, so one extra line is one false alarm.
    tree="$(lock_tree guarded)"; lock_guard "$tree"; lock_run "$tree"
    if [ "$lock_status" -ne 0 ] || [ "$lock_output" != "leapfrog-lock: current" ]; then
      printf 'lock/install did not report exactly "leapfrog-lock: current" on a guarded tree.\n' >&2
      printf '  exit: %s\n  got:  %s\n' "$lock_status" "$lock_output" >&2
      exit 1
    fi

    # 2. An unguarded stage — the path the ship sync actually takes — reports exactly one line.
    #    A leaked probe line here is how "1 out of 6 hunks FAILED" reached the sync's note on a run
    #    that went on to succeed and exit 0 (the machine agent, hobnob #6586).
    expected_change="leapfrog-lock: changed with fingerprint-circuit-breaker-v1.8.patch"
    expected_change="$expected_change (restart the shell while unlocked, or sign in again)"
    tree="$(lock_tree unguarded)"; lock_run "$tree"
    if [ "$lock_status" -ne 0 ] || [ "$lock_output" != "$expected_change" ]; then
      printf 'lock/install did not report exactly one change line on an unguarded stage.\n' >&2
      printf '  exit: %s\n  expected: %s\n  got:      %s\n' \
        "$lock_status" "$expected_change" "$lock_output" >&2
      exit 1
    fi
    if [ -e "$tree/Service.qml.orig" ]; then
      printf 'lock/install left a backup beside the plugin after a clean apply\n' >&2
      exit 1
    fi

    # 2b. ⚠️ AN OLDER GUARD IS UPGRADED, NOT CALLED "current". Every entry in CANDIDATES after the
    #     first is a guard some machine still carries, and reversing it is the only way a fix to the
    #     guard reaches that machine. A build that reports "current" for any whole guard leaves those
    #     machines on the old one for good — which is how the wake-from-sleep fault would have
    #     survived its own fix (@leapfrog, 2026-11-02 sleep tests).
    original_tree="$(lock_tree older-fingerprint-circuit-breaker)"
    if ! git -C "$lock_plugin" show HEAD:Service.qml > "$original_tree/Service.qml"; then
      printf 'script/check: cannot build the original guard fixture from the plugin history\n' >&2
      exit 1
    fi
    for older in "$LEAPFROG_DIR/lock/"fingerprint-circuit-breaker*.patch; do
      [ "$older" = "$LEAPFROG_DIR/lock/fingerprint-circuit-breaker-v1.8.patch" ] && continue
      if [ "$(basename "$older")" = fingerprint-circuit-breaker.patch ]; then
        tree="$original_tree"
        if ! patch --forward --batch --silent --no-backup-if-mismatch -d "$tree" -p1 \
          < "$older" >/dev/null 2>&1; then
          printf 'script/check: cannot apply the original guard to its historical fixture\n' >&2
          exit 1
        fi
      else
        tree="$(lock_tree "older-$(basename "$older" .patch)")"
        if ! patch --forward --batch --silent --no-backup-if-mismatch -d "$tree" -p1 \
          < "$older" >/dev/null 2>&1; then
          printf 'script/check: cannot build the required upgrade fixture for %s\n' \
            "$(basename "$older")" >&2
          exit 1
        fi
      fi
      rm -f "$tree"/*.rej
      if [ "$(basename "$older")" = fingerprint-circuit-breaker.patch ]; then
        printf 'recovery backup\n' > "$tree/Service.qml.orig"
        original_before="$(sha256sum "$tree/Service.qml")"
      fi
      lock_run "$tree"
      if [ "$(basename "$older")" = fingerprint-circuit-breaker.patch ]; then
        if [ "$lock_status" -eq 0 ]; then
          printf 'lock/install unexpectedly accepted the incompatible original-plugin upgrade\n' >&2
          exit 1
        fi
        case "$lock_output" in
          *'cannot upgrade to fingerprint-circuit-breaker-v1.8.patch'*) ;;
          *)
            printf 'lock/install did not explain the original-plugin upgrade refusal: %s\n' \
              "$lock_output" >&2
            exit 1
            ;;
        esac
        if ! grep -qF 'fingerprintFastFailures' "$tree/Service.qml" \
          || grep -qF 'fingerprintActiveCooldown' "$tree/Service.qml"; then
          printf 'lock/install removed the original guard after refusing the upgrade\n' >&2
          exit 1
        fi
        if [ ! -e "$tree/Service.qml.orig" ] \
          || [ "$(sha256sum "$tree/Service.qml")" != "$original_before" ]; then
          printf 'lock/install changed the original QML or deleted its backup after refusal\n' >&2
          exit 1
        fi
        continue
      fi
      if [ "$lock_status" -ne 0 ]; then
        printf 'lock/install failed on a tree carrying %s: %s\n' "$(basename "$older")" "$lock_output" >&2
        exit 1
      fi
      case "$lock_output" in
        *'upgrading from '*) ;;
        *)
          printf 'lock/install did not upgrade a tree carrying %s: %s\n' \
            "$(basename "$older")" "$lock_output" >&2
          exit 1
          ;;
      esac
      if ! grep -qF 'fingerprintCooldown' "$tree/Service.qml"; then
        printf 'lock/install reported an upgrade from %s but left the old guard in place\n' \
          "$(basename "$older")" >&2
        exit 1
      fi
    done

    # 3. ⚠️ THE CASE THAT ENFORCES --forward ON THE REVERSE PROBE, and the only one that does. A
    #    hunk-1-only tree is refused with or without the flag, so the obvious part-patched case
    #    proves nothing about it: four mutants passed while it stood alone (the machine agent, #6639).
    #    A MARKER-ONLY tree discriminates — the marker sits where hunk 1 would put it, so hunk 1
    #    reverses cleanly, and without --forward patch treats the other five as already-reversed
    #    and calls the tree whole.
    tree="$(lock_tree markeronly)"
    awk '{ print }
      /property bool authenticatingPassword: false/ && !seen {
        print "  property int fingerprintFastFailures: 0"; seen = 1
      }' "$tree/Service.qml" > "$tree/Service.qml.new"
    mv "$tree/Service.qml.new" "$tree/Service.qml"
    if ! grep -qF 'property int fingerprintFastFailures' "$tree/Service.qml"; then
      printf 'script/check: could not build a marker-only tree; the anchor line moved\n' >&2
      exit 1
    fi
    lock_run "$tree"
    if [ "$lock_status" -eq 0 ]; then
      printf 'lock/install reported a marker-only tree as whole. Is --forward on the reverse probe?\n' >&2
      printf '  got: %s\n' "$lock_output" >&2
      exit 1
    fi

    # 4. A tree with hunk 1 applied and the rest missing must be refused, and must keep its backup:
    #    deleting it while rejecting a part-patched plugin takes the file away exactly when someone
    #    needs it (the machine agent, hobnob #6639).
    tree="$(lock_tree hunk1only)"
    awk '/^@@/ { hunks++ } hunks < 2 { print } hunks >= 2 { exit }' \
      "$LEAPFROG_DIR/lock/fingerprint-circuit-breaker-v1.8.patch" > "$lock_work/hunk1.patch"
    patch --forward --batch --silent --no-backup-if-mismatch -d "$tree" -p1 \
      < "$lock_work/hunk1.patch" >/dev/null 2>&1
    rm -f "$tree"/*.orig "$tree"/*.rej
    cp "$tree/Service.qml" "$tree/Service.qml.orig"
    lock_run "$tree"
    if [ "$lock_status" -eq 0 ]; then
      printf 'lock/install accepted a part-patched tree: %s\n' "$lock_output" >&2
      exit 1
    fi
    case "$lock_output" in
      *'only partly applied'*) ;;
      *)
        printf 'lock/install refused a part-patched tree without saying why: %s\n' "$lock_output" >&2
        exit 1
        ;;
    esac
    if [ ! -e "$tree/Service.qml.orig" ]; then
      printf 'lock/install deleted the backup of a tree it then refused\n' >&2
      exit 1
    fi

    # 5. A guarded tree whose FIRST candidate is corrupt, for two things at once.
    #    · No probe may put patch's own words on this script's stdout, the stream the sync folds
    #      into its note. A leak was found exactly here (the machine agent, #6617): the redirections read
    #      2>&1 before >/dev/null, so stderr bound to the caller's stdout before stdout moved — and
    #      it hid behind a successful "current".
    #    · The run must REFUSE. A candidate that cannot be used is patch unable to answer, not an
    #      answer about the tree, so it is loud whether the tree is guarded or not. Without this a
    #      build reading exit 2 as "does not reverse" passes (the machine agent, #6639).
    mkdir -p "$lock_work/corrupt/lock"
    cp "$LEAPFROG_DIR/lock/install" "$lock_work/corrupt/lock/install"
    cp "$LEAPFROG_DIR/lock/"*.patch "$lock_work/corrupt/lock/"
    printf '%s\n' -- '--- a/Service.qml' '+++ b/Service.qml' '@@ -1,BOGUS +1,3 @@' > "$lock_work/corrupt/lock/fingerprint-circuit-breaker.patch"
    # ⚠️ The manifest has to be rebuilt for the corrupted copy, or the run stops at the checksum step
    # and never reaches the exit-2 handling this case exists to test — which is what 0008 did to it
    # (the machine agent's review, hobnob #6699).
    ( cd "$lock_work/corrupt/lock" \
      && sha256sum fingerprint-circuit-breaker.patch fingerprint-circuit-breaker-v1.7.patch \
        fingerprint-circuit-breaker-v1.8.patch \
        > patch-checksums.txt )
    # ⚠️ BOTH tree states. A guarded tree reaches the REVERSE probe and an unguarded one the
    # FORWARD probe, so testing only the guarded tree leaves the forward probe's redirections
    # uncovered here (the machine agent's review, hobnob #6720).
    for corrupt_state in guarded unguarded; do
      tree="$(lock_tree "corrupt-$corrupt_state")"
      [ "$corrupt_state" = guarded ] && lock_guard "$tree"
      corrupt_status=0
      corrupt_out="$("$lock_work/corrupt/lock/install" --plugin-dir "$tree" 2>/dev/null)" \
        || corrupt_status=$?
      case "$corrupt_out" in
        *patch:*|*FAILED*|*garbage*|*ignored*)
          printf 'lock/install leaked patch output to stdout past a probe (%s tree): %s\n' \
            "$corrupt_state" "$corrupt_out" >&2
          exit 1
          ;;
      esac
      if [ "$corrupt_status" -eq 0 ]; then
        printf 'lock/install accepted an unusable candidate patch (%s tree): %s\n' \
          "$corrupt_state" "$corrupt_out" >&2
        exit 1
      fi
    done

    # 6. ⚠️ THE CASE THAT ENFORCES THE LOCK GATE, under a FAKE HOME. Without omarchy-shell the lock
    #    state cannot be proved, and an unprovable state must be treated as locked; the build that
    #    skipped the gate when the command was missing passed every other case (the machine agent, #6639).
    #    The gate only engages when the target IS the live directory, so the live directory is moved
    #    rather than the target. Pointing this at the real path instead cost a file: a mutant that
    #    skips the gate deleted the live Service.qml.orig while the session was locked, which is the
    #    write the gate exists to prevent.
    gate_bin="$lock_work/gatebin"
    mkdir -p "$gate_bin"
    gate_tools_ok=yes
    for gate_tool in bash patch grep realpath rm basename cat dirname ls mktemp sha256sum; do
      gate_tool_path="$(command -v "$gate_tool" 2>/dev/null)" || { gate_tools_ok=no; break; }
      ln -sf "$gate_tool_path" "$gate_bin/$gate_tool"
    done
    gate_plugin="$lock_work/gatehome/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer"
    mkdir -p "$gate_plugin"
    cp "$lock_base/Service.qml" "$lock_base/manifest.json" "$gate_plugin/"
    printf 'backup\n' > "$gate_plugin/Service.qml.orig"
    gate_before="$(sha256sum < "$gate_plugin/Service.qml")"
    gate_case() { # gate_case <label> <expected line>
      gate_status=0
      gate_output="$(HOME="$lock_work/gatehome" PATH="$gate_bin" "$LEAPFROG_DIR/lock/install" 2>&1)" \
        || gate_status=$?
      if [ "$gate_status" -ne 0 ] || [ "$gate_output" != "$2" ] \
        || [ "$(sha256sum < "$gate_plugin/Service.qml")" != "$gate_before" ] \
        || [ ! -e "$gate_plugin/Service.qml.orig" ]; then
        printf 'lock/install wrote or misreported with %s: %s\n' "$1" "$gate_output" >&2
        exit 1
      fi
    }
    if [ "$gate_tools_ok" = yes ] && ! PATH="$gate_bin" command -v omarchy-shell >/dev/null 2>&1
    then
      gate_case "no omarchy-shell" "leapfrog-lock: deferred (lock state could not be proved safe)"
      cat > "$gate_bin/omarchy-shell" <<'STUB'
#!/bin/sh
case "$2" in status) echo '{"sessionLocked":true}' ;; isLocked) echo true ;; esac
STUB
      chmod +x "$gate_bin/omarchy-shell"
      gate_case "a locked session" "leapfrog-lock: deferred (the session is locked)"
    else
      printf 'script/check: lock-gate case SKIPPED — could not build a PATH without omarchy-shell\n' >&2
    fi
  fi
else
  # A silent skip reads the same as a pass, so say plainly when the cases did not run.
  printf 'script/check: lock-guard cases SKIPPED — no lock-explorer plugin installed\n' >&2
fi

printf 'Leapfrog checks passed.\n'
