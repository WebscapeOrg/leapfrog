#!/usr/bin/env bash
set -euo pipefail

LEAPFROG_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

cargo fmt --manifest-path "$LEAPFROG_DIR/touchbar/Cargo.toml" --check
cargo clippy --manifest-path "$LEAPFROG_DIR/touchbar/Cargo.toml" --all-targets -- -D warnings
cargo test --manifest-path "$LEAPFROG_DIR/touchbar/Cargo.toml"

for script in \
  "$LEAPFROG_DIR/install.sh" \
  "$LEAPFROG_DIR/bin/leapfrog" \
  "$LEAPFROG_DIR/camera/build-relay" \
  "$LEAPFROG_DIR/hooks/install" \
  "$LEAPFROG_DIR/hooks/post-commit" \
  "$LEAPFROG_DIR/lock/install" \
  "$LEAPFROG_DIR/system/install"; do
  bash -n "$script"
done

python3 - "$LEAPFROG_DIR/theme-gallery/generate_gallery.py" <<'PY'
from pathlib import Path
import sys

source = Path(sys.argv[1]).read_text()
compile(source, sys.argv[1], "exec")
PY

# The Enterprise ship sync patches an inert marketplace-plugin staging tree.
# Exercise that public interface even when the live plugin is already guarded.
if [ -f "$HOME/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer/Service.qml" ]; then
  staged_lock_test="$(mktemp -d)"
  trap 'find "$staged_lock_test" -depth -delete' EXIT
  cp "$HOME/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer/Service.qml" \
    "$staged_lock_test/Service.qml"
  cp "$HOME/.config/omarchy/plugins/io.github.sirjul1337.lock-explorer/manifest.json" \
    "$staged_lock_test/manifest.json"
  "$LEAPFROG_DIR/lock/install" --plugin-dir "$staged_lock_test" >/dev/null

  # ...and again on an UNGUARDED stage, the path the ship sync actually takes. A copy of the
  # live tree is already guarded, so the run above takes the "current" early exit and never
  # reaches the candidate probes. That blind spot is how a probe's "1 out of 6 hunks FAILED"
  # reached sync-ship's note on a run that went on to succeed and exit 0 (Enterprise, hobnob
  # #6586, 2026-11-02); sync-ship folds our stdout and stderr into that note, so the normal
  # path has to stay quiet.
  if patch -R --forward --batch --silent -d "$staged_lock_test" -p1 \
      < "$LEAPFROG_DIR/lock/fingerprint-circuit-breaker-v1.7.patch" 2>/dev/null; then
    unguarded_status=0
    unguarded_output="$("$LEAPFROG_DIR/lock/install" --plugin-dir "$staged_lock_test" 2>&1)" \
      || unguarded_status=$?
    if [ "$unguarded_status" -ne 0 ]; then
      printf 'lock/install failed on an unguarded stage (%d): %s\n' \
        "$unguarded_status" "$unguarded_output" >&2
      exit 1
    fi
    case "$unguarded_output" in
      *FAILED*)
        printf 'lock/install leaked a patch probe into its output: %s\n' "$unguarded_output" >&2
        exit 1
        ;;
    esac
    case "$unguarded_output" in
      *'leapfrog-lock: changed'*) ;;
      *)
        printf 'lock/install did not report a change on an unguarded stage: %s\n' \
          "$unguarded_output" >&2
        exit 1
        ;;
    esac
  fi
fi

printf 'Leapfrog checks passed.\n'
